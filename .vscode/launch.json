        {
            "type": "stlinkgdbtarget",
            "request": "attach",
            "name": "STM32Cube: Attach (ST-Link)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/hw01.elf"
                }
            ]
        }
    ]
}
